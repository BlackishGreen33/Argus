# Demo mode: sample data and demo login; changes are held in memory.
# Set false with a database + Supabase Auth for a real single-admin deployment.
DEMO_MODE=true
ADMIN_EMAIL=admin@argus.local

# Supabase + Prisma 7. Use the Transaction Pooler for DATABASE_URL at runtime
# and the direct or Session Pooler connection for DIRECT_URL migrations.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Accepts a publishable key (sb_publishable_...) or the legacy anon key.
# Never use service_role or sb_secret_... here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Show OAuth buttons only after the corresponding Supabase Provider is configured.
AUTH_GOOGLE_ENABLED=false
AUTH_GITHUB_ENABLED=false

# Unused by current app flows; no Redis database or token is needed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configure all four values for persistent cloud import jobs (DEMO_MODE=false).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_IMPORT_URL=
