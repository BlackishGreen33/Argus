# Demo mode: no Supabase, Auth, or QStash credentials are required.
DEMO_MODE=true
ADMIN_EMAIL=admin@argus.local

# Supabase + Prisma 7. Use the Transaction Pooler for DATABASE_URL at runtime
# and the direct or Session Pooler connection for DIRECT_URL migrations.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Show OAuth buttons only after the corresponding Supabase Provider is configured.
AUTH_GOOGLE_ENABLED=false
AUTH_GITHUB_ENABLED=false

# Optional Upstash Redis client (reserved for cache/workflow extensions).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional QStash integration for delayed, signed import jobs.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_IMPORT_URL=
